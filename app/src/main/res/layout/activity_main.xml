<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/lay_main_bg"
    android:orientation="vertical">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/lay_main_head_text_start"
        android:text="@string/app_name"
        android:textColor="@color/text"
        android:textSize="@dimen/lay_main_head_text_size" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginStart="@dimen/lay_main_btn_h_interval"
        android:layout_marginEnd="@dimen/lay_main_btn_h_interval"
        android:orientation="vertical">

        <Button
            android:id="@+id/lay_main_btn_find"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/lay_main_btn_v_interval"
            android:layout_marginBottom="@dimen/lay_main_btn_v_interval"
            android:layout_weight="1"
            android:backgroundTint="@color/bg"
            android:foreground="?attr/selectableItemBackground"
            android:text="@string/text_find"
            android:textAllCaps="false"
            android:textColor="@color/text"
            android:textSize="@dimen/lay_main_btn_text_size"
            app:cornerRadius="@dimen/lay_main_btn_corner_radius"
            app:icon="@drawable/ic_find"
            app:iconGravity="textStart"
            app:iconPadding="@dimen/lay_main_btn_icon_padding"
            app:iconTint="@color/text" />

        <Button
            android:id="@+id/lay_main_btn_mediateka"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/lay_main_btn_v_interval"
            android:layout_marginBottom="@dimen/lay_main_btn_v_interval"
            android:layout_weight="1"
            android:backgroundTint="@color/bg"
            android:foreground="?attr/selectableItemBackground"
            android:text="@string/text_mediateka"
            android:textAllCaps="false"
            android:textColor="@color/text"
            android:textSize="@dimen/lay_main_btn_text_size"
            app:cornerRadius="@dimen/lay_main_btn_corner_radius"
            app:icon="@drawable/ic_mediateka"
            app:iconGravity="textStart"
            app:iconPadding="@dimen/lay_main_btn_icon_padding"
            app:iconTint="@color/text" />

        <Button
            android:id="@+id/lay_main_btn_settings"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/lay_main_btn_v_interval"
            android:layout_marginBottom="@dimen/lay_main_btn_v_interval"
            android:layout_weight="1"
            android:backgroundTint="@color/bg"
            android:foreground="?attr/selectableItemBackground"
            android:text="@string/text_settings"
            android:textAllCaps="false"
            android:textColor="@color/text"
            android:textSize="@dimen/lay_main_btn_text_size"
            app:cornerRadius="@dimen/lay_main_btn_corner_radius"
            app:icon="@drawable/ic_settings"
            app:iconGravity="textStart"
            app:iconPadding="@dimen/lay_main_btn_icon_padding"
            app:iconTint="@color/text" />
    </LinearLayout>
</LinearLayout>